# MATLAB
*.asv
*.mex*
octave-workspace

# MEX — intermedios de compilación (NO al repo)
mex/bin/**/Debug/
mex/bin/**/Release/
mex/bin/**/*.obj
mex/bin/**/*.pdb

# MEX — binarios precompilados (SÍ al repo — excepciones explícitas)
!mex/bin/**/*.mexw64
!mex/bin/**/*.mexa64
!mex/bin/**/*.mexmaci64

# MEX — mex/src/ es el proyecto Visual Studio: MSBuild escribe sus
# intermedios ahí mismo (x64/Release/ por proyecto, obj, pdb, ...) y el
# post-build event de cada .vcxproj copia el binario final a
# mex/src/deploy/ — mex/build.m copia de ahí a mex/bin/ y ambos son
# transitorios, no van al repo
mex/src/**/x64/
mex/src/**/Win32/
mex/src/**/Debug/
mex/src/**/Release/
mex/src/**/*.obj
mex/src/**/*.pdb
mex/src/**/*.ilk
mex/src/**/*.exp
mex/src/**/*.lib
mex/src/**/*.tlog
mex/src/**/*.log
mex/src/**/*.idb
mex/src/deploy/
.vs/

# Fixtures de test (viven en Dropbox, no en el repo — ver tests/fixtures/README.md)
tests/fixtures/**/*
!tests/fixtures/README.md

# Claude Code — settings.local.json es específico de esta máquina/usuario
.claude/settings.local.json

# ExportFig cachea aquí rutas locales a ghostscript/pdftops (machine-specific)
src/.ignore/

# OS
.DS_Store
Thumbs.db

# Stray plaintext credential file (a global git credential.helper
# misconfiguration on this machine scatters this into whatever directory
# is cwd during a git auth — real fix is the global config, this is just
# defense in depth so it can never land in a commit here)
.gitcredentials
.git-credentials
